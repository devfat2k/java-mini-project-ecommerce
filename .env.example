# ============================================================
# Database Configuration
# Local: Docker Postgres container. Production: Render Postgres Internal URL
# ============================================================
DB_URL=jdbc:postgresql://localhost:5432/mini_shop
DB_USERNAME=
DB_PASSWORD=


CORS_ALLOWED_ORIGINS=http://localhost:8085

# ============================================================
# Redis Configuration
# Local: Docker Redis container. Production: Render Key Value Internal Host
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379



# ============================================================
# MinIO / Object Storage Configuration
# Local: MinIO container. Production: Cloudflare R2 endpoint (S3-compatible)
# ============================================================
MINIO_ENDPOINT=http://localhost:9000
MIN_IO_ACCESS_KEY=
MIN_IO_SECRET_KEY=
MIN_IO_BUCKET=mini-ecommerce-storage

# ============================================================
# Mail Configuration (SMTP Relay)
# Local: có thể dùng Gmail SMTP để test nhanh
# Production: Brevo SMTP Relay - lấy tại Brevo Dashboard > SMTP & API > tab SMTP
# ============================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
BREVO_API_KEY=
# ============================================================
# JWT Configuration
# ============================================================
JWT_SECRET_KEY=

# ============================================================
# VNPAY Sandbox Configuration
# ============================================================
VNPAY_TMN_CODE=
VNPAY_SECRET_KEY=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=
VNPAY_IPN_URL=
