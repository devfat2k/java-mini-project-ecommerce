# ==============================================================================
# Mini E-Commerce Backend - Environment Variables Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Local Development : Copy this file to `.env` and fill in local values.
# 2. Production Deploy : Use `.env.production` (or `.env.prod`) to paste key-value
#                        pairs into your hosting dashboard (e.g. Render, Railway, AWS).
# NOTE: Never commit `.env`, `.env.prod`, or `.env.production` to Git!
# ==============================================================================

# Active Spring Profile (dev / prod)
SPRING_PROFILES_ACTIVE=dev

# Server Port
PORT=8085

# Frontend URL (Used for CORS and redirect links)
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8085

# ==============================================================================
# Database Configuration (PostgreSQL)
# Local      : jdbc:postgresql://localhost:5432/mini_shop
# Production : jdbc:postgresql://<render-internal-host>:5432/<db-name>
# ==============================================================================
DB_URL=jdbc:postgresql://localhost:5432/mini_shop
DB_USERNAME=postgres
DB_PASSWORD=postgres123

# ==============================================================================
# Redis Configuration
# Local      : localhost / 6379 (Docker container)
# Production : Render Redis / Upstash / AWS ElastiCache
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================================================
# Object Storage Configuration (MinIO / Cloudflare R2 / AWS S3)
# Local      : http://localhost:9000 (MinIO container)
# Production : https://<account_id>.r2.cloudflarestorage.com
# ==============================================================================
MINIO_ENDPOINT=http://localhost:9000
MIN_IO_ACCESS_KEY=admin
MIN_IO_SECRET_KEY=admin12345
MIN_IO_BUCKET=mini-ecommerce

# ==============================================================================
# Mail Configuration (SMTP / Brevo)
# Local      : Gmail SMTP or Brevo SMTP Relay
# Production : Brevo SMTP Relay (Dashboard -> SMTP & API -> SMTP Credentials)
# ==============================================================================
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=your-verified-email@domain.com

# ==============================================================================
# JWT Security Configuration (HS256 Secret - Min 256 bits / 32+ chars)
# ==============================================================================
JWT_SECRET_KEY=YourSuperSecretKeyWithMinimum32CharactersLengthForSecurity

# ==============================================================================
# VNPay Sandbox Configuration
# ==============================================================================
VNPAY_TMN_CODE=
VNPAY_SECRET_KEY=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://your-domain.com/api/v1/payments/vnpay-return
VNPAY_IPN_URL=https://your-domain.com/api/v1/payments/vnpay-ipn

# Schedulers (Optional overrides)
OTP_CLEANUP_CRON=0 0 * * * *
PAYMENT_EXPIRED_CRON=0 */2 * * * *
